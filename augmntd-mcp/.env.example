# Server Configuration
PORT=8080
NODE_ENV=production

# Security & OIDC (Optional in dev, required in production)
# OIDC_CLIENT_ID=your-oidc-client-id
# OIDC_CLIENT_SECRET=your-oidc-client-secret
# JWT_SECRET=your-jwt-secret

# Enterprise Database / System of Record (Optional for mock ledger, required for live DB)
# DATABASE_URL=postgresql://user:password@localhost:5432/enterprise_db

# Harmonic Coherence Engine Defaults
# TAU_K=1.61803398875
# CHEEGER_FLOOR=0.61803398875
